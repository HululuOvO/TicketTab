{
  "name": "ticket-tab",
  "productName": "TicketTab",
  "version": "1.0.0",
  "author": "TicketTab Studio",
  "description": "Edge-docked tactile receipt-printer desktop task board for Windows & macOS",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/store.test.js",
    "icons": "node scripts/generate-icons.js",
    "pack:win": "electron-builder --win --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tickettab.desktop",
    "productName": "TicketTab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "mcp/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "mcp/**/*",
      "src/shared/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    }
  }
}
